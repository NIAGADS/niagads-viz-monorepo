{
    "name": "@niagads/viz-js",
    "version": "0.1.0",
    "author": "fossilfriend,bug-sam",
    "scripts": {
        "watch": "npx lerna watch -- lerna run build --scope=\\$LERNA_PACKAGE_NAME",
        "storybook": "concurrently \"npm run watch\" \"npx lerna run storybook\"",
        "genome-browser": "concurrently \"npm run watch\" \"npx lerna run genome-browser\"",
        "genomicsdb": "concurrently \"npm run watch\" \"npx lerna run genomicsdb\"",
        "genomicsdb-build": "npx lerna run build-genomicsdb",
        "niagads-main": "concurrently \"npm run watch\" \"npx lerna run niagads-main\"",
        "ui-playground": "concurrently \"npm run watch\" \"npx lerna run ui-playground\"",
        "lint": "npx prettier . --write",
        "clean-dist": "find ./packages -name 'dist' -type d -prune -exec rm -rf '{}' +",
        "clean-node-modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
        "build": "npx lerna run build --concurrency 1",
        "build-fresh": "npm run clean-dist && npm run build"
    },
    "workspaces": [
        "packages/Common",
        "packages/Gosling",
        "packages/IGVBrowser",
        "packages/LocusZoom",
        "packages/Table",
        "packages/Charts",
        "packages/UI",
        "apps/storybook",
        "apps/genomicsdb",
        "apps/igvbrowser",
        "apps/niagads-main",
        "apps/ui-playground"
    ],
    "devDependencies": {
        "concurrently": "^9.1.2",
        "lerna": "^10.0.0",
        "prettier": "^3.5.3"
    },
    "engines": {
        "node": ">=24.15.0 <25.0.0",
        "npm": ">=12.0.2 <13.0.0"
    },
    "allowScripts": {
        "es5-ext": true,
        "nx": true,
        "esbuild": true,
        "unrs-resolver": true,
        "sharp": true,
        "NIAGADS/igv.js": true,
        "NIAGADS/export-from-json": true
    }
}
