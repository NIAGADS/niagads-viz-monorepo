{
    "name": "@niagads/viz-js",
    "version": "0.1.0",
    "author": "fossilfriend,bug-sam",
    "scripts": {
        "watch": "npx lerna watch -- lerna run build --scope=\\$LERNA_PACKAGE_NAME",
        "storybook": "concurrently \"npm run watch\" \"npx lerna run storybook\"",
        "igvbrowser": "concurrently \"npm run watch\" \"npx lerna run igvbrowser\"",
        "genomicsdb": "concurrently \"npm run watch\" \"npx lerna run genomicsdb\"",
        "genomicsdb-debug": "concurrently \"npm run watch\" \"npx lerna run genomicsdb-debug\"",
        "genomicsdb-prod": "npx lerna run genomicsdb-prod",
        "genomicsdb-build": "npx lerna run genomicsdb-build",
        "ui-playground": "concurrently \"npm run watch\" \"npx lerna run ui-playground\"",
        "lint": "npx prettier . --write",
        "clean-dist": "find ./packages -name 'dist' -type d -prune -exec rm -rf '{}' +",
        "clean-node-modules": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' +",
        "build": "npx lerna run build --concurrency 1",
        "build-fresh": "npm run clean-dist && npm run build"
    },
    "workspaces": [
        "packages/Common",
        "packages/Gosling",
        "packages/IGVBrowser",
        "packages/LocusZoom",
        "packages/Table",
        "packages/Charts",
        "packages/UI",
        "apps/storybook",
        "apps/genomicsdb",
        "apps/igvbrowser",
        "apps/ui-playground"
    ],
    "devDependencies": {
        "concurrently": "^9.1.2",
        "lerna": "^10.0.0",
        "prettier": "^3.5.3"
    },
    "engines": {
        "node": ">=24.15.0 <25.0.0",
        "npm": "12.0.2"
    },
    "allowScripts": {
        "es5-ext@0.10.64": true,
        "esbuild@0.27.4": true,
        "nx@23.1.1": true,
        "sharp": true,
        "unrs-resolver@1.11.1": true,
        "github:NIAGADS/igv.js#53e6169d6fb8fcaeecd8ce369e622a79824f5ef7": true,
        "github:NIAGADS/export-from-json#122dec96e063279cc65c2ef0c94ed92cc796f452": true
    }
}
